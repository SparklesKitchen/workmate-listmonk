# This route deliberately lives on the existing SaaS Admin host. Caddy removes
# the external namespace before forwarding to native Listmonk, while native
# redirects back into that namespace.
handle /saas-admin/listmonk/* {
	uri strip_prefix /saas-admin/listmonk
	reverse_proxy 127.0.0.1:9100 {
		header_down Location "^/admin(.*)$" "/saas-admin/listmonk/admin$1"
	}
}
