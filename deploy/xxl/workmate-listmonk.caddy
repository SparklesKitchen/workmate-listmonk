# Legacy namespace. Reach now lives at reach.workmateos.co.uk; the old
# app.workmateos.co.uk/saas-admin/listmonk/* URLs redirect there and the
# reach vhost strips the prefix before forwarding to native Listmonk.
(workmate-listmonk) {
	handle /saas-admin/listmonk/* {
		redir https://reach.workmateos.co.uk{uri} 302
	}
}
